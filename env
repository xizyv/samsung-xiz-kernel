#!/bin/bash

export maindir="$(pwd)"
export outside="${maindir}/.."

export ARCH="arm64"
export SUBARCH="arm64"
export KBUILD_BUILD_USER="xizyv"
export KBUILD_BUILD_HOST="github-actions"

if [[ -z "$zipper_repo" ]]; then
  export zipper_repo="https://github.com/MrGadget84/AnyKernel3"
fi
if [[ -z "$zipper_branch" ]]; then
  export zipper_branch="a325f"
fi

export defconfig="${DCFG:-mt6768-unifiedk414_lineage_defconfig}"
export defconfig_file="${maindir}/arch/${ARCH}/configs/${defconfig}"

if [[ -n "$FRAG" && -f "${maindir}/arch/${ARCH}/configs/${FRAG}" ]]; then
  cat "${defconfig_file}" "${maindir}/arch/${ARCH}/configs/${FRAG}" > "${maindir}/arch/${ARCH}/configs/merged_defconfig"
  export defconfig="merged_defconfig"
  export defconfig_file="${maindir}/arch/${ARCH}/configs/merged_defconfig"
fi

if [[ -n "$REBRAND" ]]; then
  sed -i '/^CONFIG_LOCALVERSION=/d' "${defconfig_file}"
  echo "CONFIG_LOCALVERSION=\"-${REBRAND}\"" >> "${defconfig_file}"
fi

export out_image="${maindir}/out/arch/${ARCH}/boot/Image.gz"
export out_dtb="${maindir}/out/arch/${ARCH}/boot/dtb"
export out_dtbo="${maindir}/out/arch/${ARCH}/boot/dtbo.img"
export zipper="${outside}/zipper"

export kernel_head="$(git log --pretty=format:'%h' -1)"
export kernel_name=$(cat "${defconfig_file}" | grep "CONFIG_LOCALVERSION=" | sed 's/CONFIG_LOCALVERSION="-*//g' | sed 's/"*//g')
export kernel_ver="$(make kernelversion)"
export TIME=$(date +"%y%m%d-%H%M")
export zip_name="${maindir}/${kernel_name}${SUFFIX}-${TIME}-${kernel_head}.zip"

grep -q '^CONFIG_ANDROID_BINDERFS=' "${defconfig_file}" || echo "CONFIG_ANDROID_BINDERFS=y" >> "${defconfig_file}"
grep -q '^CONFIG_MEMCG=' "${defconfig_file}" || echo "CONFIG_MEMCG=y" >> "${defconfig_file}"
grep -q '^CONFIG_BPF_SYSCALL=' "${defconfig_file}" || echo "CONFIG_BPF_SYSCALL=y" >> "${defconfig_file}"
